// =====================================================
// ALARME MQ-2
// =====================================================
void atualizarAlarmeMQ2() {

  if (ppmMQ2 > LIMITE_MQ2_ALARME) {

    if (!alarmeMQ2Ativo) {

      alarmeMQ2Ativo = true;

      inicioAlarmeMQ2 =
        millis();

      ultimoPiscaMQ2 =
        millis();

      estadoPiscaMQ2 =
        false;

      setColor(0, 0, 0);

      tone(
        BUZZER,
        2000
      );

      buzzerMQ2Ativo = true;

      Serial.println(
        "!!! ALERTA MQ-2 !!!"
      );

      Serial.println(
        "MQ-2 acima de 1500 ppm"
      );

      Serial.println(
        "Buzzer acionado por 10 segundos."
      );
    }

    unsigned long agora =
      millis();

    if (
      agora -
      ultimoPiscaMQ2 >=
      INTERVALO_PISCA_MQ2
    ) {

      ultimoPiscaMQ2 =
        agora;

      estadoPiscaMQ2 =
        !estadoPiscaMQ2;

      if (estadoPiscaMQ2) {

        setColor(
          255,
          0,
          0
        );

      } else {

        setColor(
          0,
          0,
          0
        );
      }
    }

    if (
      buzzerMQ2Ativo &&
      agora -
      inicioAlarmeMQ2 >=
      DURACAO_BUZZER_MQ2
    ) {

      noTone(
        BUZZER
      );

      buzzerMQ2Ativo =
        false;

      Serial.println(
        "Buzzer MQ-2 desligado."
      );
    }

  } else {

    if (alarmeMQ2Ativo) {

      Serial.println(
        "MQ-2 voltou ao normal."
      );
    }

    alarmeMQ2Ativo = false;
    buzzerMQ2Ativo = false;

    noTone(BUZZER);

    estadoPiscaMQ2 = false;

    atualizarLEDChuva();
  }
}

// =====================================================
// LEITURA DA CHUVA
// =====================================================
void atualizarChuva() {

  chuvaAnalogico =
    analogRead(CHUVA_AO);

  chuvaDigital =
    digitalRead(CHUVA_DO);

  chovendoAgora =
    (chuvaDigital == LOW);

  if (
    chovendoAgora &&
    !chuvaAnterior
  ) {

    ultimaChuvaMillis =
      millis();

    jaChoveu = true;
  }

  chuvaAnterior =
    chovendoAgora;

  atualizarLEDChuva();
}

// =====================================================
// STATUS DO SOM
// =====================================================
String statusSom(float db) {

  if (db >= DB_EXTREMO)
    return "Extremo";

  if (db >= DB_ALTO)
    return "Alto";

  if (db >= DB_ALERTA)
    return "Alerta";

  if (db >= DB_MODERADO)
    return "Moderado";

  if (db >= DB_BAIXO)
    return "Baixo";

  return "Muito Baixo";
}

// =====================================================
// LEITURA KY-037
// =====================================================
void lerSensorSom() {

  unsigned long inicio =
    millis();

  somValorMaximo = 0;
  somValorMinimo = 1023;

  while (
    millis() -
    inicio <
    JANELA_SOM
  ) {

    int leitura =
      analogRead(sensorSom);

    if (
      leitura >
      somValorMaximo
    ) {

      somValorMaximo =
        leitura;
    }

    if (
      leitura <
      somValorMinimo
    ) {

      somValorMinimo =
        leitura;
    }
  }

  somAmplitude =
    somValorMaximo -
    somValorMinimo;

  if (
    somAmplitude < 1
  ) {

    somAmplitude = 1;
  }

  somDB =
    dBReferencia +
    20.0 *
    log10(
      (float)somAmplitude /
      amplitudeReferencia
    );

  if (
    !somFlashAtivo &&
    somDB >= DB_ALERTA &&
    !alarmeMQ2Ativo
  ) {

    int r =
      random(0, 256);

    int g =
      random(0, 256);

    int b =
      random(0, 256);

    setColor(
      r,
      g,
      b
    );

    somFlashAtivo = true;

    somFlashFim =
      millis() +
      DURACAO_FLASH_SOM;
  }

  if (
    somFlashAtivo &&
    millis() >=
    somFlashFim
  ) {

    somFlashAtivo = false;

    atualizarLEDChuva();
  }

  if (
    somDB >= DB_ALTO
  ) {

    if (
      !fotoJaSolicitadaNesteEvento
    ) {

      solicitarFotoESP32CAM();

      fotoJaSolicitadaNesteEvento =
        true;
    }

  } else {

    fotoJaSolicitadaNesteEvento =
      false;
  }

  Serial.print("Som | Min: ");
  Serial.print(somValorMinimo);

  Serial.print(" | Max: ");
  Serial.print(somValorMaximo);

  Serial.print(" | Amplitude: ");
  Serial.print(somAmplitude);

  Serial.print(" | Nivel sonoro estimado: ");
  Serial.print(somDB, 1);

  Serial.println(" dB");
}

