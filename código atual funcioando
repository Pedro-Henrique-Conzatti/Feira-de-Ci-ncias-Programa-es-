// =====================================================
// BUZZER DO SOM EXTREMO
// =====================================================
void atualizarBuzzerSom(float db) {

  if (alarmeMQ2Ativo) {
    return;
  }

  if (db >= DB_EXTREMO) {

    buzzerOn = true;

  } else {

    buzzerOn = false;

    noTone(BUZZER);

    buzzerState = false;
  }

  if (buzzerOn) {

    unsigned long agora =
      millis();

    if (
      agora -
      buzzerToggleTime >=
      150
    ) {

      buzzerToggleTime =
        agora;

      buzzerState =
        !buzzerState;

      if (buzzerState) {

        tone(
          BUZZER,
          2000
        );

      } else {

        noTone(
          BUZZER
        );
      }
    }
  }
}

// =====================================================
// BCD -> DECIMAL
// =====================================================
byte bcdParaDec(byte val) {

  return (
    (val / 16 * 10) +
    (val % 16)
  );
}

// =====================================================
// DECIMAL -> BCD
// =====================================================
byte decParaBcd(byte val) {

  return (
    (val / 10 * 16) +
    (val % 10)
  );
}

// =====================================================
// ESCREVE DATA/HORA NO RTC
// =====================================================
bool ajustarDataHora(
  byte seg,
  byte min,
  byte hr,
  byte diaSem,
  byte d,
  byte m,
  byte a
) {

  rtcWire.beginTransmission(
    DS1307_ADDRESS
  );

  rtcWire.write(0x00);

  rtcWire.write(
    decParaBcd(seg)
  );

  rtcWire.write(
    decParaBcd(min)
  );

  rtcWire.write(
    decParaBcd(hr)
  );

  rtcWire.write(
    decParaBcd(diaSem)
  );

  rtcWire.write(
    decParaBcd(d)
  );

  rtcWire.write(
    decParaBcd(m)
  );

  rtcWire.write(
    decParaBcd(a)
  );

  return (
    rtcWire.endTransmission() ==
    0
  );
}

// =====================================================
// CONFIGURA RTC UMA ÚNICA VEZ
// 17/08/2026 - 15:54:00
// =====================================================
void configurarRTCUmaVez() {

  byte marcador =
    EEPROM.read(
      EEPROM_ENDERECO_RTC
    );

  if (
    marcador ==
    MARCADOR_RTC
  ) {

    Serial.println(
      "RTC ja foi configurado anteriormente."
    );

    return;
  }

  Serial.println(
    "================================"
  );

  Serial.println(
    "NOVA CONFIGURACAO DO RTC"
  );

  Serial.println(
    "17/08/2026 - 15:54:00"
  );

  Serial.println(
    "================================"
  );

  bool sucesso =
    ajustarDataHora(
      RTC_SEGUNDO_CONFIG,
      RTC_MINUTO_CONFIG,
      RTC_HORA_CONFIG,
      2,
      RTC_DIA_CONFIG,
      RTC_MES_CONFIG,
      RTC_ANO_CONFIG
    );

  if (sucesso) {

    EEPROM.update(
      EEPROM_ENDERECO_RTC,
      MARCADOR_RTC
    );

    Serial.println(
      "RTC configurado com sucesso."
    );

  } else {

    Serial.println(
      "ERRO ao configurar o RTC!"
    );
  }
}

// =====================================================
// LE DATA/HORA DO RTC
// =====================================================
bool lerDataHora() {

  rtcWire.beginTransmission(
    DS1307_ADDRESS
  );

  rtcWire.write(
    0x00
  );

  uint8_t erro =
    rtcWire.endTransmission();

  if (
    erro != 0
  ) {

    return false;
  }

  int quantidade =
    rtcWire.requestFrom(
      DS1307_ADDRESS,
      7
    );

  if (
    quantidade != 7
  ) {

    return false;
  }

  if (
    rtcWire.available() <
    7
  ) {

    return false;
  }

  byte novoSegundo =
    bcdParaDec(
      rtcWire.read() &
      0x7F
    );

  byte novoMinuto =
    bcdParaDec(
      rtcWire.read() &
      0x7F
    );

  byte novaHora =
    bcdParaDec(
      rtcWire.read() &
      0x3F
    );

  byte novoDiaSem =
    bcdParaDec(
      rtcWire.read() &
      0x07
    );

  byte novoDia =
    bcdParaDec(
      rtcWire.read() &
      0x3F
    );

  byte novoMes =
    bcdParaDec(
      rtcWire.read() &
      0x1F
    );

  byte novoAno =
    bcdParaDec(
      rtcWire.read()
    );

  if (
    novoSegundo > 59
  )
    return false;

  if (
    novoMinuto > 59
  )
    return false;

  if (
    novaHora > 23
  )
    return false;

  if (
    novoDia < 1 ||
    novoDia > 31
  )
    return false;

  if (
    novoMes < 1 ||
    novoMes > 12
  )
    return false;

  segundo =
    novoSegundo;

  minuto =
    novoMinuto;

  hora =
    novaHora;

  diaSemana =
    novoDiaSem;

  dia =
    novoDia;

  mes =
    novoMes;

  ano =
    novoAno;

  return true;
}

