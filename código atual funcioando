      lcd.print(
        "Hora:"
      );

      if (
        hora < 10
      )
        lcd.print(
          "0"
        );

      lcd.print(
        hora
      );

      lcd.print(
        ":"
      );

      if (
        minuto < 10
      )
        lcd.print(
          "0"
        );

      lcd.print(
        minuto
      );

      lcd.print(
        ":"
      );

      if (
        segundo < 10
      )
        lcd.print(
          "0"
        );

      lcd.print(
        segundo
      );

      break;

    // =================================================
    // 6 - ESP32-CAM
    // =================================================
    case 6:

      lcd.setCursor(0, 0);

      lcd.print(
        "ESP32-CAM:"
      );

      lcd.setCursor(0, 1);

      lcd.print(
        ultimaMensagemESP32
      );

      break;
  }
}

// =====================================================
// SETUP
// =====================================================
void setup() {

  Serial.begin(9600);

  Serial2.begin(
    BAUD_ESP32CAM
  );

  rtcWire.begin();

  rtcWire.setTimeout(
    RTC_TIMEOUT_MS
  );

  dht.begin();

  pinMode(
    RED,
    OUTPUT
  );

  pinMode(
    GREEN,
    OUTPUT
  );

  pinMode(
    BLUE,
    OUTPUT
  );

  pinMode(
    BUZZER,
    OUTPUT
  );

  pinMode(
    CHUVA_DO,
    INPUT
  );

  randomSeed(
    analogRead(A2)
  );

  lcd.init();

  lcd.backlight();

  lcd.setCursor(0, 0);

  lcd.print(
    "Projeto Feira"
  );

  lcd.setCursor(0, 1);

  lcd.print(
    "Iniciando..."
  );

  // ===================================================
  // CALIBRAÇÃO MQ
  // ===================================================
  calibrarSensoresMQ();

  // ===================================================
  // PRIMEIRA LEITURA DA CHUVA
  // ===================================================
  atualizarChuva();

  chuvaAnterior =
    chovendoAgora;

  // ===================================================
  // CONFIGURA RTC UMA ÚNICA VEZ
  // ===================================================
  configurarRTCUmaVez();

  // ===================================================
  // PRIMEIRA LEITURA RTC
  // ===================================================
  bool rtcOK =
    lerDataHora();

  if (
    !rtcOK
  ) {

    Serial.println(
      "AVISO: RTC nao respondeu."
    );

  } else {

    Serial.print(
      "RTC atual: "
    );

    if (
      dia < 10
    )
      Serial.print(
        "0"
      );

    Serial.print(
      dia
    );

    Serial.print(
      "/"
    );

    if (
      mes < 10
    )
      Serial.print(
        "0"
      );

    Serial.print(
      mes
    );

    Serial.print(
      "/20"
    );

    Serial.print(
      ano
    );

    Serial.print(
      " "
    );

    if (
      hora < 10
    )
      Serial.print(
        "0"
      );

    Serial.print(
      hora
    );

    Serial.print(
      ":"
    );

    if (
      minuto < 10
    )
      Serial.print(
        "0"
      );

    Serial.print(
      minuto
    );

    Serial.print(
      ":"
    );

    if (
      segundo < 10
    )
      Serial.print(
        "0"
      );

    Serial.println(
      segundo
    );
  }

  delay(2000);

  lcd.clear();

  mostrarTela(
    currentScreen
  );

  atualizarLEDChuva();

  Serial.println(
    "================================"
  );

  Serial.println(
    "Projeto Feira iniciado"
  );

  Serial.println(
    "================================"
  );
}

// =====================================================
// LOOP PRINCIPAL
// =====================================================
void loop() {

  unsigned long agora =
    millis();

  // ===================================================
  // LEITURA DOS SENSORES
  // ===================================================
  if (
    agora -
    lastSensorRead >=
    SENSOR_INTERVAL
  ) {

    lastSensorRead =
      agora;

    lerSensores();

    lerSensoresMQ();

    atualizarChuva();

    lerSensorSom();

    mostrarTela(
      currentScreen
    );
  }

  // ===================================================
  // ALARME MQ-2
  // ===================================================
  atualizarAlarmeMQ2();

  // ===================================================
  // RTC
  // ===================================================
  if (
    agora -
    lastRTCRead >=
    RTC_INTERVAL
  ) {

    lastRTCRead =
      agora;

    if (
      lerDataHora()
    ) {

      if (
        currentScreen == 5
      ) {

        mostrarTela(
          currentScreen
        );
      }
    }
  }

  // ===================================================
  // BUZZER DO SOM
  // ===================================================
  atualizarBuzzerSom(
    somDB
  );

  // ===================================================
  // ESP32-CAM
  // ===================================================
  verificarESP32CAM();

  // ===================================================
  // TROCA DE TELA
  // ===================================================
  if (
    agora -
    lastScreenChange >=
    SCREEN_INTERVAL
  ) {

    lastScreenChange =
      agora;

    currentScreen++;

    if (
      currentScreen >= 7
    ) {

      currentScreen =
        0;
    }

    mostrarTela(
      currentScreen
    );
  }

  // ===================================================
  // PRIMEIRA EXECUÇÃO
  // ===================================================
  static bool firstRun =
    true;

  if (
    firstRun
  ) {

    mostrarTela(
      currentScreen
    );

    firstRun =
      false;
  }
}
