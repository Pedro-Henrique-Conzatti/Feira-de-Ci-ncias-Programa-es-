// =====================================================
// BCD -> DECIMAL
// =====================================================
byte bcdParaDec(byte val) {

  return ((val / 16 * 10) + (val % 16));
}

// =====================================================
// DECIMAL -> BCD
// =====================================================
byte decParaBcd(byte val) {

  return ((val / 10 * 16) + (val % 10));
}

// =====================================================
// ESCREVE DATA/HORA NO RTC
// =====================================================
bool ajustarDataHora(
  byte seg,
  byte min,
  byte hr,
  byte diaSem,
  byte d,
  byte m,
  byte a
) {

  rtcWire.beginTransmission(DS1307_ADDRESS);

  rtcWire.write(0x00);

  rtcWire.write(decParaBcd(seg));
  rtcWire.write(decParaBcd(min));
  rtcWire.write(decParaBcd(hr));
  rtcWire.write(decParaBcd(diaSem));
  rtcWire.write(decParaBcd(d));
  rtcWire.write(decParaBcd(m));
  rtcWire.write(decParaBcd(a));

  return rtcWire.endTransmission() == 0;
}

// =====================================================
// LÊ DATA/HORA DO RTC
// =====================================================
bool lerDataHora() {

  rtcWire.beginTransmission(DS1307_ADDRESS);

  rtcWire.write(0x00);

  uint8_t erro = rtcWire.endTransmission();

  if (erro != 0) {

    return false;
  }

  int quantidade = rtcWire.requestFrom(
    DS1307_ADDRESS,
    7
  );

  if (quantidade != 7) {

    return false;
  }

  if (rtcWire.available() < 7) {

    return false;
  }

  byte novoSegundo =
    bcdParaDec(rtcWire.read() & 0x7F);

  byte novoMinuto =
    bcdParaDec(rtcWire.read() & 0x7F);

  byte novaHora =
    bcdParaDec(rtcWire.read() & 0x3F);

  byte novoDiaSem =
    bcdParaDec(rtcWire.read() & 0x07);

  byte novoDia =
    bcdParaDec(rtcWire.read() & 0x3F);

  byte novoMes =
    bcdParaDec(rtcWire.read() & 0x1F);

  byte novoAno =
    bcdParaDec(rtcWire.read());

  // ===================================================
  // VALIDAÇÃO
  // ===================================================
  if (novoSegundo > 59)
    return false;

  if (novoMinuto > 59)
    return false;

  if (novaHora > 23)
    return false;

  if (novoDia < 1 || novoDia > 31)
    return false;

  if (novoMes < 1 || novoMes > 12)
    return false;

  // ===================================================
  // SALVA OS VALORES
  // ===================================================
  segundo = novoSegundo;
  minuto = novoMinuto;
  hora = novaHora;

  diaSemana = novoDiaSem;

  dia = novoDia;
  mes = novoMes;
  ano = novoAno;

  return true;
}

// =====================================================
// CONVERTE MÊS DA COMPILAÇÃO
// =====================================================
byte mesParaNumero(char *mesTexto) {

  const char meses[] =
    "JanFebMarAprMayJunJulAugSepOctNovDec";

  char buf[4];

  buf[0] = mesTexto[0];
  buf[1] = mesTexto[1];
  buf[2] = mesTexto[2];
  buf[3] = '\0';

  for (byte i = 0; i < 12; i++) {

    if (
      strncmp(
        buf,
        meses + (i * 3),
        3
      ) == 0
    ) {

      return i + 1;
    }
  }

  return 1;
}

// =====================================================
// AJUSTA RTC PELA HORA DE COMPILAÇÃO
// =====================================================
void ajustarHoraComHoraDeCompilacao() {

  char dataCompilacao[] = __DATE__;
  char horaCompilacao[] = __TIME__;

  byte m =
    mesParaNumero(dataCompilacao);

  byte d =
    atoi(dataCompilacao + 4);

  int a =
    atoi(dataCompilacao + 7);

  byte h =
    atoi(horaCompilacao);

  byte mi =
    atoi(horaCompilacao + 3);

  byte s =
    atoi(horaCompilacao + 6);

  if (
    ajustarDataHora(
      s,
      mi,
      h,
      1,
      d,
      m,
      (byte)(a - 2000)
    )
  ) {

    Serial.println(
      "RTC ajustado pela hora de compilacao."
    );

  } else {

    Serial.println(
      "ERRO ao ajustar o RTC."
    );
  }
}

// =====================================================
// ENVIA FOTO PARA ESP32-CAM
// =====================================================
void solicitarFotoESP32CAM() {

  Serial2.println("FOTO");

  Serial.println(
    "Comando FOTO enviado ao ESP32-CAM."
  );
}

// =====================================================
// RECEBE ESP32-CAM
// =====================================================
void verificarESP32CAM() {

  while (Serial2.available()) {

    char c = Serial2.read();

    if (c == '\n') {

      mensagemESP32.trim();

      if (mensagemESP32.length() > 0) {

        ultimaMensagemESP32 =
          mensagemESP32;

        Serial.print(
          "Recebido do ESP32-CAM: "
        );

        Serial.println(
          ultimaMensagemESP32
        );
      }

      mensagemESP32 = "";

    } else {

      mensagemESP32 += c;
    }
  }
}

// =====================================================
// LCD
// =====================================================
void mostrarTela(int tela) {

  lcd.clear();

  switch (tela) {

    // =================================================
    // 0 - TEMPERATURA / UMIDADE
    // =================================================
    case 0:

      lcd.setCursor(0, 0);

      lcd.print("Temperatura:");

      lcd.print(temp, 1);

      lcd.print((char)223);

      lcd.print("C");

      lcd.setCursor(0, 1);

      lcd.print("Umidade:");

      lcd.print(hum, 0);

      lcd.print("%");

      break;

    // =================================================
    // 1 - MQ135
    // =================================================
    case 1:

      lcd.setCursor(0, 0);

      lcd.print("Qualidade do ar:");

      lcd.setCursor(0, 1);

      lcd.print(
        nivelMQ135(mq135ppm)
      );

      break;

    // =================================================
    // 2 - MQ2
    // =================================================
    case 2:

      lcd.setCursor(0, 0);

      lcd.print("Gas / Fumaca:");

      lcd.setCursor(0, 1);

      lcd.print(
        nivelMQ2(mq2ppm)
      );

      break;

    // =================================================
    // 3 - IQRA
    // =================================================
    case 3:

      lcd.setCursor(0, 0);

      lcd.print("Nivel:");

      lcd.print(iqra);

      lcd.print("/10");

      lcd.setCursor(0, 1);

      lcd.print("Status:");

      lcd.print(
        statusIQRA(iqra)
      );

      break;

    // =================================================
    // 4 - CHUVA
    // =================================================
    case 4:

      lcd.setCursor(0, 0);

      lcd.print("Chuva:");

      lcd.print(
        statusChuva(chuvaDigital)
      );

      lcd.setCursor(0, 1);

      lcd.print("Analog:");

      lcd.print(chuvaAnalogico);

      break;

    // =================================================
    // 5 - SOM
    // =================================================
    case 5:

      lcd.setCursor(0, 0);

      lcd.print("Som:");

      lcd.print(
        statusSom(somNivel)
      );

      lcd.setCursor(0, 1);

      lcd.print("Valor:");

      lcd.print(somNivel);

      break;

    // =================================================
    // 6 - DATA / HORA
    // =================================================
    case 6:

      lcd.setCursor(0, 0);

      lcd.print("Data:");

      if (dia < 10)
        lcd.print("0");

      lcd.print(dia);

      lcd.print("/");

      if (mes < 10)
        lcd.print("0");

      lcd.print(mes);

      lcd.print("/20");

      if (ano < 10)
        lcd.print("0");

      lcd.print(ano);

      lcd.setCursor(0, 1);

      lcd.print("Hora:");

      if (hora < 10)
        lcd.print("0");

      lcd.print(hora);

      lcd.print(":");

      if (minuto < 10)
        lcd.print("0");

      lcd.print(minuto);

      lcd.print(":");

      if (segundo < 10)
        lcd.print("0");

      lcd.print(segundo);

      break;

    // =================================================
    // 7 - ESP32-CAM
    // =================================================
    case 7:

      lcd.setCursor(0, 0);

      lcd.print("ESP32-CAM:");

      lcd.setCursor(0, 1);

      lcd.print(
        ultimaMensagemESP32
      );

      break;
  }
}

// =====================================================
// SETUP
// =====================================================
void setup() {

  Serial.begin(9600);

  // ESP32-CAM
  Serial2.begin(BAUD_ESP32CAM);

  // RTC
  rtcWire.begin();

  // IMPORTANTE:
  // impede o SoftwareWire de ficar preso
  // caso o RTC nao responda.
  rtcWire.setTimeout(RTC_TIMEOUT_MS);

  // DHT
  dht.begin();

  // Pinos
  pinMode(RED, OUTPUT);
  pinMode(GREEN, OUTPUT);
  pinMode(BLUE, OUTPUT);

  pinMode(BUZZER, OUTPUT);

  pinMode(CHUVA_DO, INPUT);

  // Aleatorio
  randomSeed(analogRead(A2));

  // LCD
  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("Projeto Feira");

  lcd.setCursor(0, 1);
  lcd.print("Iniciando...");

  // ===================================================
  // AJUSTE MANUAL PELA COMPILACAO
  // ===================================================
  if (AJUSTAR_HORA_NA_COMPILACAO) {

    ajustarHoraComHoraDeCompilacao();
  }

  // ===================================================
  // PRIMEIRA LEITURA DO RTC
  // ===================================================
  bool rtcOK = lerDataHora();

  // ===================================================
  // SE ESTIVER EM 2000, CONSIDERA RTC ZERADO
  // ===================================================
  if (rtcOK && ano < 26) {

    Serial.println(
      "RTC zerado/invalido."
    );

    Serial.println(
      "Ajustando pela hora de compilacao..."
    );

    ajustarHoraComHoraDeCompilacao();

    lerDataHora();
  }

  if (!rtcOK) {

    Serial.println(
      "AVISO: RTC nao respondeu."
    );
  }

  delay(2000);

  lcd.clear();

  mostrarTela(currentScreen);

  Serial.println(
    "================================"
  );

  Serial.println(
    "Projeto Feira iniciado"
  );

  Serial.println(
    "================================"
  );
}

// =====================================================
// LOOP
// =====================================================
void loop() {

  unsigned long agora = millis();

  bool somExtremo = false;

  // ===================================================
  // SENSORES
  // ===================================================
  if (
    agora - lastSensorRead >=
    SENSOR_INTERVAL
  ) {

    lastSensorRead = agora;

    lerSensores();

    if (!somFlashAtivo) {

      atualizarRGB(iqra);
    }

    // Atualiza a tela atual com os dados novos
    // sem depender do RTC.
    mostrarTela(currentScreen);
  }

  // ===================================================
  // RTC
  // ===================================================
  if (
    agora - lastRTCRead >=
    RTC_INTERVAL
  ) {

    lastRTCRead = agora;

    // Se o RTC falhar, o programa continua.
    if (lerDataHora()) {

      if (currentScreen == 6) {

        mostrarTela(currentScreen);
      }
    }
  }

  // ===================================================
  // SOM
  // ===================================================
  somExtremo =
    verificarSom();

  // ===================================================
  // ESP32-CAM
  // ===================================================
  verificarESP32CAM();

  // ===================================================
  // BUZZER
  // ===================================================
  atualizarBuzzer(
    iqra,
    somExtremo
  );

  // ===================================================
  // TROCA DE TELA
  // ===================================================
  if (
    agora - lastScreenChange >=
    SCREEN_INTERVAL
  ) {

    lastScreenChange = agora;

    currentScreen++;

    if (currentScreen >= 8) {

      currentScreen = 0;
    }

    mostrarTela(currentScreen);
  }

  // ===================================================
  // PRIMEIRA EXECUCAO
  // ===================================================
  static bool firstRun = true;

  if (firstRun) {

    mostrarTela(currentScreen);

    firstRun = false;
  }
}
