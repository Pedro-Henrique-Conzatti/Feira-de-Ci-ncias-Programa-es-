// =====================================================
// RECEBE ESP32-CAM
// =====================================================
void verificarESP32CAM() {

  while (
    Serial2.available()
  ) {

    char c =
      Serial2.read();

    if (
      c == '\n'
    ) {

      mensagemESP32.trim();

      if (
        mensagemESP32.length() >
        0
      ) {

        ultimaMensagemESP32 =
          mensagemESP32;

        Serial.print(
          "Recebido do ESP32-CAM: "
        );

        Serial.println(
          ultimaMensagemESP32
        );
      }

      mensagemESP32 =
        "";

    } else {

      mensagemESP32 += c;
    }
  }
}

