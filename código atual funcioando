#include <DHT.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// ===== DHT11 =====
#define DHTPIN 7
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

// ===== MQ135 / MQ2 =====
#define MQ135PIN A0
#define MQ2PIN A1

// ===== RGB =====
#define RED 9
#define GREEN 10
#define BLUE 11

// ===== BUZZER =====
#define BUZZER 6

// ===== LCD I2C 16x2 =====
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ===== CONTROLE DE TELAS =====
unsigned long lastScreenChange = 0;
unsigned long lastSensorRead = 0;
const unsigned long SCREEN_INTERVAL = 10000; // 10s por tela
const unsigned long SENSOR_INTERVAL = 1000;  // leitura sensores cada 1s
int currentScreen = 0; // 0..3

// ===== VARIÁVEIS GLOBAIS DOS SENSORES =====
float temp = 0;
float hum = 0;
int mq135Raw = 0;
int mq2Raw = 0;
float mq135ppm = 0;
float mq2ppm = 0;
int iqra = 1; // 1 (ótimo) a 10 (péssimo)

// ===== BUZZER STATE (não bloqueante) =====
bool buzzerOn = false;
unsigned long buzzerToggleTime = 0;
bool buzzerState = false;

void setup() {
  Serial.begin(9600);

  dht.begin();

  pinMode(RED, OUTPUT);
  pinMode(GREEN, OUTPUT);
  pinMode(BLUE, OUTPUT);
  pinMode(BUZZER, OUTPUT);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Projeto Feira");
  lcd.setCursor(0, 1);
  lcd.print("Iniciando...");
  delay(2000);
  lcd.clear();
}

// ===== RGB =====
void setColor(int r, int g, int b) {
  analogWrite(RED, r);
  analogWrite(GREEN, g);
  analogWrite(BLUE, b);
}

// ===== CONVERSÃO MQ135 -> ppm estimado (CO2 aproximado) =====
float convertMQ135ToPPM(int raw) {
  // Estimativa simplificada baseada na leitura analógica (0-1023)
  // Faixa aproximada: 400 a 2000 ppm
  float ppm = map(raw, 0, 1023, 400, 2000);
  return ppm;
}

// ===== CONVERSÃO MQ2 -> ppm estimado (gás/fumaça) =====
float convertMQ2ToPPM(int raw) {
  // Estimativa simplificada (0-1023 -> 200-10000 ppm aprox)
  float ppm = map(raw, 0, 1023, 200, 10000);
  return ppm;
}

// ===== CÁLCULO DO IQRA (1 a 10, 10 = pior) =====
int calcularIQRA(float t, float h, float mq135, float mq2) {
  int score = 1;

  // Temperatura
  if (t > 40) score = max(score, 10);
  else if (t >= 35) score = max(score, 8);
  else if (t >= 30) score = max(score, 5);
  else if (t < 18) score = max(score, 4);

  // Umidade
  if (h < 20 || h > 98) score = max(score, 10);
  else if (h < 30 || h > 70) score = max(score, 8);
  else if (h < 40 || h > 60) score = max(score, 5);

  // MQ135 (qualidade do ar - CO2 equivalente)
  if (mq135 > 1500) score = max(score, 10);
  else if (mq135 > 1000) score = max(score, 8);
  else if (mq135 > 700) score = max(score, 5);

  // MQ2 (gás/fumaça)
  if (mq2 > 6000) score = max(score, 10);
  else if (mq2 > 3000) score = max(score, 8);
  else if (mq2 > 1000) score = max(score, 5);

  return score;
}

// ===== ATUALIZA RGB BASEADO NO IQRA (1 cor por nivel) =====
void atualizarRGB(int nivel) {
  switch (nivel) {
    case 1:  setColor(0, 0, 255);     break; // Azul        - Excelente
    case 2:  setColor(0, 255, 255);   break; // Ciano       - Bom
    case 3:  setColor(0, 255, 0);     break; // Verde       - Bom
    case 4:  setColor(150, 255, 0);   break; // Verde-limao - Atencao
    case 5:  setColor(255, 255, 0);   break; // Amarelo     - Atencao
    case 6:  setColor(255, 180, 0);   break; // Amarelo-ouro- Atencao
    case 7:  setColor(255, 80, 0);    break; // Laranja     - Perigoso
    case 8:  setColor(255, 0, 150);   break; // Rosa/Magenta- Perigoso
    case 9:  setColor(150, 0, 255);   break; // Roxo        - Critico
    case 10: setColor(255, 0, 0);     break; // Vermelho    - Critico
    default: setColor(255, 255, 255); break; // Branco      - Erro/fallback
  }
}

// ===== BUZZER NÃO BLOQUEANTE (só nível 10) =====
void atualizarBuzzer(int nivel) {
  if (nivel >= 10) {
    buzzerOn = true;
  } else {
    buzzerOn = false;
    noTone(BUZZER);
    buzzerState = false;
  }

  if (buzzerOn) {
    unsigned long now = millis();
    if (now - buzzerToggleTime >= 150) {
      buzzerToggleTime = now;
      buzzerState = !buzzerState;
      if (buzzerState) {
        tone(BUZZER, 2000);
      } else {
        noTone(BUZZER);
      }
    }
  }
}

// ===== LEITURA DOS SENSORES =====
void lerSensores() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t)) temp = t;
  if (!isnan(h)) hum = h;

  mq135Raw = analogRead(MQ135PIN);
  mq2Raw = analogRead(MQ2PIN);

  mq135ppm = convertMQ135ToPPM(mq135Raw);
  mq2ppm = convertMQ2ToPPM(mq2Raw);

  iqra = calcularIQRA(temp, hum, mq135ppm, mq2ppm);

  Serial.print("Temp: ");
  Serial.print(temp);
  Serial.print(" C | Hum: ");
  Serial.print(hum);
  Serial.print(" % | MQ135: ");
  Serial.print(mq135ppm);
  Serial.print(" ppm | MQ2: ");
  Serial.print(mq2ppm);
  Serial.print(" ppm | IQRA: ");
  Serial.println(iqra);
}

// ===== LIMIARES DE NIVEL (STATUS GERAL) =====
const int NIVEL_1  = 1;
const int NIVEL_2  = 2;
const int NIVEL_3  = 3;
const int NIVEL_4  = 4;
const int NIVEL_5  = 5;
const int NIVEL_6  = 6;
const int NIVEL_7  = 7;
const int NIVEL_8  = 8;
const int NIVEL_9  = 9;
const int NIVEL_10 = 10;

// ===== STATUS TEXTUAL DO IQRA =====
String statusIQRA(int nivel) {
  if (nivel >= NIVEL_9)  return "Critico!";
  if (nivel >= NIVEL_7)  return "Perigoso";
  if (nivel >= NIVEL_4)  return "Atencao";
  if (nivel >= NIVEL_2)  return "Bom";
  return "Excelente";
}

// ===== NIVEL SIMPLES PARA O MQ135 (qualidade do ar) =====
String nivelMQ135(float ppm) {
  if (ppm > 1500) return "Muito poluido";
  if (ppm > 1000) return "Poluido";
  if (ppm > 700) return "Moderado";
  return "Ar limpo";
}

// ===== NIVEL SIMPLES PARA O MQ2 (gas/fumaca) =====
String nivelMQ2(float ppm) {
  if (ppm > 6000) return "Muito gas!";
  if (ppm > 3000) return "Gas alto";
  if (ppm > 1000) return "Gas moderado";
  return "Sem gas";
}

// ===== TELAS DO LCD =====
void mostrarTela(int tela) {
  lcd.clear();

  switch (tela) {
    case 0: // Temp / Umidade
      lcd.setCursor(0, 0);
      lcd.print("Temperatura: ");
      lcd.print(temp, 1);
      lcd.print((char)223);
      lcd.print("C");

      lcd.setCursor(0, 1);
      lcd.print("Umidade: ");
      lcd.print(hum, 0);
      lcd.print("%");
      break;

    case 1: // MQ135
      lcd.setCursor(0, 0);
      lcd.print("Qualidade do ar:");

      lcd.setCursor(0, 1);
      lcd.print(nivelMQ135(mq135ppm));
      break;

    case 2: // MQ2
      lcd.setCursor(0, 0);
      lcd.print("Gas / Fumaca:");

      lcd.setCursor(0, 1);
      lcd.print(nivelMQ2(mq2ppm));
      break;

    case 3: // IQRA + Status
      lcd.setCursor(0, 0);
      lcd.print("Nivel: ");
      lcd.print(iqra);
      lcd.print("/10");

      lcd.setCursor(0, 1);
      lcd.print("Status: ");
      lcd.print(statusIQRA(iqra));
      break;
  }
}

void loop() {
  unsigned long now = millis();

  // Leitura periódica dos sensores
  if (now - lastSensorRead >= SENSOR_INTERVAL) {
    lastSensorRead = now;
    lerSensores();
    atualizarRGB(iqra);
    mostrarTela(currentScreen); // atualiza o LCD com os valores novos
  }

  // Atualiza buzzer de forma não bloqueante
  atualizarBuzzer(iqra);

  // Troca de tela a cada 10s
  if (now - lastScreenChange >= SCREEN_INTERVAL) {
    lastScreenChange = now;
    currentScreen = (currentScreen + 1) % 4;
    mostrarTela(currentScreen);
  }

  // Mostra a tela inicial imediatamente
  static bool firstRun = true;
  if (firstRun) {
    mostrarTela(currentScreen);
    firstRun = false;
  }
}
