// =====================================================
// RGB
// =====================================================
void setColor(int r, int g, int b) {

  analogWrite(RED, r);
  analogWrite(GREEN, g);
  analogWrite(BLUE, b);
}

// =====================================================
// MQ135 -> PPM ESTIMADO
// =====================================================
float convertMQ135ToPPM(int raw) {

  return map(raw, 0, 1023, 400, 2000);
}

// =====================================================
// MQ2 -> PPM ESTIMADO
// =====================================================
float convertMQ2ToPPM(int raw) {

  return map(raw, 0, 1023, 200, 10000);
}

// =====================================================
// IQRA
// =====================================================
int calcularIQRA(float t, float h, float mq135, float mq2) {

  int score = 1;

  // Temperatura
  if (t > 40)
    score = max(score, 10);

  else if (t >= 35)
    score = max(score, 8);

  else if (t >= 30)
    score = max(score, 5);

  else if (t < 18)
    score = max(score, 4);

  // Umidade
  if (h < 20 || h > 98)
    score = max(score, 10);

  else if (h < 30 || h > 70)
    score = max(score, 8);

  else if (h < 40 || h > 60)
    score = max(score, 5);

  // MQ135
  if (mq135 > 1500)
    score = max(score, 10);

  else if (mq135 > 1000)
    score = max(score, 8);

  else if (mq135 > 700)
    score = max(score, 5);

  // MQ2
  if (mq2 > 6000)
    score = max(score, 10);

  else if (mq2 > 3000)
    score = max(score, 8);

  else if (mq2 > 1000)
    score = max(score, 5);

  return score;
}

// =====================================================
// RGB PELO IQRA
// =====================================================
void atualizarRGB(int nivel) {

  switch (nivel) {

    case 1:
      setColor(0, 0, 255);
      break;

    case 2:
      setColor(0, 255, 255);
      break;

    case 3:
      setColor(0, 255, 0);
      break;

    case 4:
      setColor(150, 255, 0);
      break;

    case 5:
      setColor(255, 255, 0);
      break;

    case 6:
      setColor(255, 180, 0);
      break;

    case 7:
      setColor(255, 80, 0);
      break;

    case 8:
      setColor(255, 0, 150);
      break;

    case 9:
      setColor(150, 0, 255);
      break;

    case 10:
      setColor(255, 0, 0);
      break;

    default:
      setColor(255, 255, 255);
      break;
  }
}

// =====================================================
// BUZZER
// =====================================================
void atualizarBuzzer(int nivel, bool somExtremo) {

  if (nivel >= 10 || somExtremo) {

    buzzerOn = true;

  } else {

    buzzerOn = false;

    noTone(BUZZER);

    buzzerState = false;
  }

  if (buzzerOn) {

    unsigned long agora = millis();

    if (agora - buzzerToggleTime >= 150) {

      buzzerToggleTime = agora;

      buzzerState = !buzzerState;

      if (buzzerState) {
        tone(BUZZER, 2000);
      } else {
        noTone(BUZZER);
      }
    }
  }
}

// =====================================================
// STATUS DO SOM
// =====================================================
String statusSom(int valor) {

  if (valor >= LIMIAR_EXTREMO)
    return "Extremo";

  if (valor >= LIMIAR_ALTO)
    return "Alto/Perigoso";

  if (valor >= LIMIAR_ALERTA)
    return "Alerta";

  if (valor >= LIMIAR_MODERADO)
    return "Moderado";

  if (valor >= LIMIAR_BAIXO)
    return "Baixo";

  return "Muito Baixo";
}

// =====================================================
// SOM
// =====================================================
bool verificarSom() {

  somNivel = analogRead(SOM_AO);

  bool somExtremo = (somNivel >= LIMIAR_EXTREMO);

  // Flash RGB
  if (!somFlashAtivo && somNivel >= LIMIAR_ALERTA) {

    int r = random(0, 256);
    int g = random(0, 256);
    int b = random(0, 256);

    setColor(r, g, b);

    somFlashAtivo = true;

    somFlashFim = millis() + DURACAO_FLASH_SOM;
  }

  // Finaliza flash
  if (somFlashAtivo && millis() >= somFlashFim) {

    somFlashAtivo = false;

    atualizarRGB(iqra);
  }

  // ===================================================
  // FOTO ESP32-CAM
  // ===================================================
  if (somNivel >= LIMIAR_ALTO) {

    if (!fotoJaSolicitadaNesteEvento) {

      solicitarFotoESP32CAM();

      fotoJaSolicitadaNesteEvento = true;
    }

  } else {

    fotoJaSolicitadaNesteEvento = false;
  }

  return somExtremo;
}

// =====================================================
// LEITURA DOS SENSORES
// =====================================================
void lerSensores() {

  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t))
    temp = t;

  if (!isnan(h))
    hum = h;

  mq135Raw = analogRead(MQ135PIN);
  mq2Raw = analogRead(MQ2PIN);

  mq135ppm = convertMQ135ToPPM(mq135Raw);
  mq2ppm = convertMQ2ToPPM(mq2Raw);

  iqra = calcularIQRA(
    temp,
    hum,
    mq135ppm,
    mq2ppm
  );

  chuvaAnalogico = analogRead(CHUVA_AO);

  chuvaDigital = digitalRead(CHUVA_DO);

  // Monitor serial
  Serial.print("Temp: ");
  Serial.print(temp);

  Serial.print(" C | Hum: ");
  Serial.print(hum);

  Serial.print(" % | MQ135: ");
  Serial.print(mq135ppm);

  Serial.print(" ppm | MQ2: ");
  Serial.print(mq2ppm);

  Serial.print(" ppm | IQRA: ");
  Serial.print(iqra);

  Serial.print(" | Chuva AO: ");
  Serial.print(chuvaAnalogico);

  Serial.print(" | Chuva DO: ");
  Serial.print(chuvaDigital);

  Serial.print(" | Som: ");
  Serial.print(somNivel);

  Serial.print(" (");
  Serial.print(statusSom(somNivel));
  Serial.println(")");
}

