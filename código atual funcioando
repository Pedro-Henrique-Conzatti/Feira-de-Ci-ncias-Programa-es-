// =====================================================
// MÉDIA DE 20 LEITURAS
// =====================================================
int mediaSensor(int pino) {

  long soma = 0;

  for (int i = 0; i < 20; i++) {

    soma += analogRead(pino);

    delay(5);
  }

  return soma / 20;
}

// =====================================================
// CÁLCULO MQ-2
// =====================================================
int calcularMQ2(int leitura) {

  float diferenca = leitura - baseMQ2;

  if (diferenca < 10) {
    return 0;
  }

  float proporcao =
    diferenca / (1023.0 - baseMQ2);

  proporcao = constrain(
    proporcao,
    0.0,
    1.0
  );

  int ppm =
    300 +
    proporcao * (10000 - 300);

  return ppm;
}

// =====================================================
// CÁLCULO MQ-135
// =====================================================
int calcularMQ135(int leitura) {

  float diferenca = leitura - baseMQ135;

  if (diferenca < 10) {
    return 0;
  }

  float proporcao =
    diferenca / (1023.0 - baseMQ135);

  proporcao = constrain(
    proporcao,
    0.0,
    1.0
  );

  int ppm =
    10 +
    proporcao * (1000 - 10);

  return ppm;
}

// =====================================================
// CALIBRAÇÃO DOS MQ
// =====================================================
void calibrarSensoresMQ() {

  Serial.println("================================");
  Serial.println("Estacao de Monitoramento Ambiental");
  Serial.println("Calibrando sensores...");
  Serial.println("Mantenha os sensores em ar ambiente.");
  Serial.println("Nao coloque fumaca ou gases proximos.");
  Serial.println("================================");

  long somaMQ2 = 0;
  long somaMQ135 = 0;

  for (int i = 0; i < AMOSTRAS_CALIBRACAO; i++) {

    somaMQ2 += analogRead(PIN_MQ2);
    somaMQ135 += analogRead(PIN_MQ135);

    delay(50);
  }

  baseMQ2 =
    somaMQ2 / (float)AMOSTRAS_CALIBRACAO;

  baseMQ135 =
    somaMQ135 / (float)AMOSTRAS_CALIBRACAO;

  Serial.println("Calibracao concluida.");

  Serial.print("Base MQ-2: ");
  Serial.println(baseMQ2);

  Serial.print("Base MQ-135: ");
  Serial.println(baseMQ135);

  Serial.println("================================");
}

